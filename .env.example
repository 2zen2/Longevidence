# Database. This matches docker-compose.yml. For a local Postgres use postgresql://localhost/longevidence_db
DATABASE_URL=postgresql://longevidence:longevidence@localhost:5433/longevidence_db

# Optional: model help for unusual questions (the app works without it)
# LLM_PROVIDER=openrouter        # anthropic | openai | openrouter | google
# LLM_MODEL=deepseek/deepseek-v4.1-flash
# LLM_API_KEY=

# Optional: browser origins allowed to call the API (default: any). Example: http://localhost:5173,http://localhost:3000
# CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
# INGEST_TOKEN=           # optional: require this token (X-Ingest-Token) on ingest POSTs; set the same value for the web app

# Optional: only when fetching new papers from PubMed
# NCBI_EMAIL=you@example.com

# Optional: where `make seed` downloads the example data if seed/data.sql.gz is missing
# SEED_URL=
